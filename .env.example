# Application mode. Keep local for the filesystem version; use hosted only after
# PostgreSQL, both passwords, and the private image bucket are configured.
APP_MODE=local
APP_ENV=development
HOST=0.0.0.0
PORT=5176
ANNOTATION_EXPERT_MODE=false

# Temporary outer gate for the staging smoke deployment.
# Do not reuse these values for the later user/admin authentication system.
STAGING_AUTH_REQUIRED=false
STAGING_USER=
STAGING_PASSWORD=

# Hosted mode: PostgreSQL and role authentication.
DATABASE_URL=
DATABASE_SSL=false
AUTH_SESSION_HOURS=12
AUTH_SECURE_COOKIES=true
AUTH_ANNOTATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
# Hash variables may be used instead of the plaintext password variables.
AUTH_ANNOTATOR_PASSWORD_HASH=
AUTH_ADMIN_PASSWORD_HASH=

# Hosted mode: private JPEG bucket. Railway can inject these from a Bucket.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual
MAX_JPEG_BYTES=62914560

# Scheduled research exports should use a second private bucket.
BACKUP_AWS_ENDPOINT_URL=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_S3_BUCKET_NAME=
BACKUP_AWS_DEFAULT_REGION=auto
BACKUP_AWS_S3_URL_STYLE=virtual
